{
  "name": "agent-docs-starter",
  "version": "0.1.0",
  "private": true,
  "description": "给人看、也给 AI 查的文档站模板（基于 Nimbus）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "node --test tests/*.test.mjs && node scripts/check-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "docs:query": "node scripts/docs-query.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:check": "node scripts/install-skills.mjs --check"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.19.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@iconify-json/ph": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "7.3.3",
    "clsx": "^2.1.1",
    "satori": "^0.26.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@tailwindcss/vite": "^4.1.4",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3"
  }
}
